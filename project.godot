config_version=5

[application]

config/name="Physics Project -- Midterm"
config/description="Hello, this is supposed to be our project for our midterm on Physics. This showcases the Laws of Motion, and how this game should solve a problem."
config/version="1.0.0"
run/main_scene="uid://yupgfffcp445"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"

[display]

window/size/mode=3
window/stretch/mode="viewport"

[dotnet]

project/assembly_name="New Game Project"

